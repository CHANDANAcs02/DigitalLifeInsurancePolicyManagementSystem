{
  "info": {
    "name": "Digital Life Insurance - JWT API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerEmail",
      "value": "customer@gmail.com"
    },
    {
      "key": "customerPassword",
      "value": "Password@123"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "planId",
      "value": "1"
    },
    {
      "key": "policyId",
      "value": "1"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"name\": \"John Doe\",\n  \"phone\": \"9876543210\",\n  \"dateOfBirth\": \"1998-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@insurance.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "plans"
              ]
            }
          }
        },
        {
          "name": "Calculate Premium",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 30,\n  \"coverageAmount\": 5000000,\n  \"termYears\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans/calculate-premium",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "plans",
                "calculate-premium"
              ]
            }
          }
        },
        {
          "name": "Create Plan - Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Life\",\n  \"description\": \"Admin-created plan\",\n  \"coverageAmount\": 7500000,\n  \"termYears\": 25,\n  \"basePremium\": 22000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "plans"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "Create Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"planId\": {{planId}},\n  \"coverageAmount\": 5000000,\n  \"termYears\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Get Policy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}"
              ]
            }
          }
        },
        {
          "name": "Renew Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/renew",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}",
                "renew"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "First Premium Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": {{policyId}},\n  \"amount\": 15000,\n  \"paymentType\": \"FIRST_PREMIUM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Policy Payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Policy Premiums",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}/premiums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}",
                "premiums"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Security Test",
      "item": [
        {
          "name": "Admin Endpoint With Customer Token - Expect 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Be Forbidden\",\n  \"description\": \"security test\",\n  \"coverageAmount\": 1000000,\n  \"termYears\": 10,\n  \"basePremium\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "plans"
              ]
            }
          }
        }
      ]
    }
  ]
}